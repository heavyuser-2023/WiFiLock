{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiFiLock",
  "version": "2.5.0",
  "identifier": "com.wifilock.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "heavyuser-2023",
    "copyright": "Copyright (c) 2026 heavyuser-2023",
    "license": "MIT",
    "homepage": "https://github.com/heavyuser-2023/WiFiLock",
    "shortDescription": "와이파이와 가까운 블루투스 기기에 맞춰 화면 자동 잠금을 조절합니다",
    "longDescription": "등록한 와이파이(집·사무실)에서는 길게, 낯선 곳에서는 짧게 잠금을 조절하고, 아이폰·미밴드·에어팟 같은 지정 블루투스 기기가 근처에 있을 때는 자동 잠금을 똑똑하게 보류하는 메뉴 막대·알림 영역 앱입니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/ko.lproj/InfoPlist.strings": "macos/ko.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings"
      },
      "signingIdentity": "-",
      "entitlements": "macos/entitlements.plist"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
