{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WiFiLock",
  "version": "2.0.0",
  "identifier": "com.wifilock.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "heavyuser-2023",
    "copyright": "Copyright (c) 2026 heavyuser-2023",
    "license": "MIT",
    "homepage": "https://github.com/heavyuser-2023/WiFiLock",
    "shortDescription": "와이파이 연결 상태에 따라 자동 화면 잠금 시간을 바꿔 줍니다",
    "longDescription": "등록한 네트워크(집·사무실)에서는 길게, 낯선 와이파이에서는 짧게, 와이파이가 없으면 더 짧게 자동으로 화면을 잠그는 메뉴 막대·알림 영역 앱입니다.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/ko.lproj/InfoPlist.strings": "macos/ko.lproj/InfoPlist.strings",
        "Resources/en.lproj/InfoPlist.strings": "macos/en.lproj/InfoPlist.strings"
      },
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "en-US"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}
