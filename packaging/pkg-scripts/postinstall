#!/bin/sh
# 설치가 끝나면 현재 로그인한 사용자 계정으로 앱을 실행한다.
APP="/Applications/WiFiLock.app"
CONSOLE_USER=$(/usr/bin/stat -f %Su /dev/console 2>/dev/null)
if [ -d "$APP" ] && [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
    CONSOLE_UID=$(/usr/bin/id -u "$CONSOLE_USER")
    /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -u "$CONSOLE_USER" /usr/bin/open "$APP" || true
fi
exit 0
