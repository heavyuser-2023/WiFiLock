<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>와이파이 잠금</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="never" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0"/>
        </allowed-os-versions>
    </volume-check>
    <choices-outline>
        <line choice="default">
            <line choice="com.wifilock.WiFiLock.pkg"/>
        </line>
    </choices-outline>
    <choice id="default"/>
    <choice id="com.wifilock.WiFiLock.pkg" visible="false">
        <pkg-ref id="com.wifilock.WiFiLock.pkg"/>
    </choice>
    <pkg-ref id="com.wifilock.WiFiLock.pkg" version="__VERSION__" onConclusion="none">WiFiLock-component.pkg</pkg-ref>
</installer-gui-script>
